# Cadena de conexión de Postgres para LA APLICACIÓN.
#
# Usa el rol `mfw_app`, que NO es superusuario ni dueño de las tablas. Eso es lo
# que hace que las políticas de seguridad por fila (drizzle/0001_rls.sql) se le
# apliquen de verdad: un superusuario se las salta todas, y el usuario que crea
# la base lo es. El rol se crea con `pnpm db:app-role`.
DATABASE_URL=postgres://mfw_app:mfw_app@localhost:5432/mfw

# Cadena de conexión del DUEÑO, solo para las migraciones.
#
# Cambiar la forma de las tablas necesita privilegios que la aplicación no debe
# tener. La usa drizzle.config.ts y nadie más. En producción, la del recurso de
# Dokploy.
DATABASE_OWNER_URL=postgres://mfw:mfw@localhost:5432/mfw

# Secreto de firma de sesiones. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-o-mas-aleatorios

# URL pública de la app. En produccion, el dominio real.
BETTER_AUTH_URL=http://localhost:4321

# Código de invitación para crear una cuenta. Se comprueba en el servidor, en
# `src/auth.ts`: sin él NO se registra nadie, aunque llame al endpoint con curl.
# Si esta variable falta, el registro queda cerrado. Es a propósito: un
# despliegue al que se le olvidó debe quedarse con la puerta cerrada, no abierta.
SIGNUP_INVITE_CODE=pon-aqui-un-codigo-que-solo-sepas-tu
