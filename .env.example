# Cadena de conexión de Postgres.
#
# En local, si levantas la base con `docker compose -f compose.dev.yml up -d`:
DATABASE_URL=postgres://mfw:mfw@localhost:5432/mfw

# En producción la da Dokploy al crear el recurso de base de datos. Apunta al
# nombre del servicio dentro de la red interna, no a localhost.

# Secreto de firma de sesiones. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-o-mas-aleatorios

# URL pública de la app. En produccion, el dominio real.
BETTER_AUTH_URL=http://localhost:4321

# Código de invitación para crear una cuenta. Se comprueba en el servidor, en
# `src/auth.ts`: sin él NO se registra nadie, aunque llame al endpoint con curl.
# Si esta variable falta, el registro queda cerrado. Es a propósito: un
# despliegue al que se le olvidó debe quedarse con la puerta cerrada, no abierta.
SIGNUP_INVITE_CODE=pon-aqui-un-codigo-que-solo-sepas-tu
