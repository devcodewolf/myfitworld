---
import '@/styles/global.css';
import AppNav from '@/components/nav/AppNav.astro';
import PlateMark from '@/components/ui/PlateMark.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="min-h-dvh text-ink">
    <!--
      THESIS: A plan you move through by date, not a dashboard you read. The
      week-and-day rail is the spine and photography carries every surface; it
      refuses the sidebar-plus-text-cards app shell it replaced.
      OWN-WORLD: Blue-black ground lit by three fixed radial washes. Full-bleed
      still-life photography of real equipment, cooled and dimmed under a
      ground-to-transparent gradient, with metadata as glass chips over it. One
      saturated cyan (#34dafa) reserved for the primary action and for now; four
      low-chroma pastels identify the mesocycle phases. Archivo variable, tabular
      figures, hairline borders, no shadows.
      STORY: He lands on the rail, sees which week and day he is on, and the next
      session fills the screen with one action on it.
      FIRST VIEWPORT: Top pill nav; mesocycle name and counters; week rail over
      day rail; then the next session as a 21:9 photographic card carrying its
      title at display scale, its chips and its action.
      FORM: brief-pinned by two references the user supplied (FitPRO, NOW!);
      no direction roll. Craft bar Apple Fitness / Nike Training Club; seed 7f81f74b.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, DESIGN.md, and every shipping raster carrying its
      provenance
    -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2.5 focus:font-semibold focus:text-accent-ink"
    >
      Saltar al contenido
    </a>
    <PlateMark />
    <AppNav />
    <main id="contenido" class="mx-auto w-full max-w-[92rem] lg:px-6 lg:pb-10">
      <slot />
    </main>
  </body>
</html>
