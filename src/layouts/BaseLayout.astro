---
import '@/styles/global.css';
import AppNav from '@/components/nav/AppNav.astro';
import PlateMark from '@/components/ui/PlateMark.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="grid min-h-dvh grid-rows-[auto_1fr] text-ink">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2.5 focus:font-semibold focus:text-accent-ink"
    >
      Saltar al contenido
    </a>
    {
      /**
       * El `body` es una rejilla de dos filas: la cabecera ocupa lo que ocupe y
       * `main` se queda **todo el resto**. Es lo que permite centrar una página
       * en vertical sin restarle a mano la altura de la cabecera: esa resta la
       * hace el navegador, y sigue siendo correcta si la cabecera cambia de
       * alto algún día.
       *
       * Solo hay dos filas porque los otros dos hijos están fuera del flujo: el
       * enlace de salto es `sr-only` (absoluto) y el disco del fondo es fijo.
       */
    }
    <PlateMark />
    <AppNav />
    <main id="contenido" class="mx-auto w-full max-w-[92rem] lg:px-6">
      <slot />
    </main>
  </body>
</html>
