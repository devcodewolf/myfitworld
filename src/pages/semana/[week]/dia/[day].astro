---
import type { GetStaticPaths } from 'astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import BlockRow from '@/components/routine/BlockRow.astro';
import WeekNav from '@/components/routine/WeekNav.astro';
import PhotoCard from '@/components/ui/PhotoCard.astro';
import { getActiveMesocycle, getExerciseCatalog } from '@/data';
import { PHASE_LABELS, formatDuration, formatReserve } from '@/core/labels';
import { routes } from '@/routes';
import { daySetCount, estimateDaySeconds, groupSupersets } from '@/core/training';
import { PHASE_PALETTE, dayPhoto } from '@/theme';

export const getStaticPaths = (async () => {
  const mesocycle = await getActiveMesocycle();
  return mesocycle.weeks.flatMap((week) =>
    week.days.map((day) => ({
      params: { week: String(week.order), day: String(day.order) },
      props: { week, day, mesocycle },
    })),
  );
}) satisfies GetStaticPaths;

const { week, day, mesocycle } = Astro.props;
const catalog = await getExerciseCatalog();

const groups = groupSupersets(day);
const sets = daySetCount(day);
const seconds = estimateDaySeconds(day, catalog);
const reserve = day.blocks[0]?.repsInReserve;
const palette = PHASE_PALETTE[week.phase];
const chips = [
  `${sets} series`,
  `${day.blocks.length} ejercicios`,
  formatDuration(seconds),
  ...(reserve !== undefined ? [formatReserve(reserve)] : []),
];

// Numeración continua sobre los bloques, respetando el agrupado por superserie.
let position = 0;
---

<BaseLayout
  title={`Semana ${week.order} · Día ${day.order} · ${day.title}`}
  description={day.focus}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <WeekNav mesocycle={mesocycle} activeWeek={week.order} activeDay={day.order} />

    <div class="pt-8">
      {
        /* Proporción 21:9 solo desde `md`. Un `aspect-ratio` con `min-height` traslada
           ese mínimo al ancho (19rem × 21/9 ≈ 709px): se sale de cualquier pantalla
           por debajo de `md`. En móvil la tarjeta crece con su contenido. */
      }
      <PhotoCard
        photo={dayPhoto(week.order, day.order)}
        alt=""
        eager
        fill
        class="min-h-[30rem] md:aspect-[21/9] md:min-h-76"
      >
        <h1 class="text-display font-black tracking-[-0.03em] text-balance text-ink">
          {day.title}
        </h1>
        <p
          class="figures mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-bold text-ink-dim"
        >
          <span class:list={['h-0.5 w-6 rounded-full', palette.mark]} aria-hidden="true"></span>
          Semana {String(week.order).padStart(2, '0')} · {PHASE_LABELS[week.phase]} · Día {
            day.order
          }
        </p>
        <p class="mt-3 max-w-[55ch] text-base leading-relaxed text-ink-dim">{day.focus}</p>

        <div class="mt-5 flex flex-wrap items-center gap-4">
          <a
            href={routes.train(week.order, day.order)}
            class="accion-primaria inline-flex min-h-14 items-center justify-center gap-3 rounded-full px-7 text-base font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100"
          >
            Entrenar
          </a>
          <ul class="figures flex flex-wrap gap-2">
            {
              chips.map((chip) => (
                <li class="rounded-full border border-line bg-[color-mix(in_oklab,var(--color-ground)_65%,transparent)] px-3.5 py-1.5 text-sm font-semibold text-ink backdrop-blur-sm">
                  {chip}
                </li>
              ))
            }
          </ul>
        </div>
      </PhotoCard>
    </div>

    {
      day.warmupNotes && (
        <section class="border-b border-line py-8" aria-labelledby="calentamiento">
          <h2
            id="calentamiento"
            class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase"
          >
            Calentamiento
          </h2>
          <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-dim">{day.warmupNotes}</p>
        </section>
      )
    }

    <section class="pt-8" aria-labelledby="ejercicios">
      <h2
        id="ejercicios"
        class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase"
      >
        Ejercicios
      </h2>
      {
        groups.map((group) =>
          group.length === 1 ? (
            <ul>
              <BlockRow
                block={group[0]!}
                catalog={catalog}
                position={(position += 1)}
                from={{ week: week.order, day: day.order }}
              />
            </ul>
          ) : (
            <div class="panel my-4 rounded-card border border-line-strong px-5">
              <p class="figures pt-5 text-[0.72rem] font-bold tracking-[0.2em] text-ink-dim uppercase">
                Superserie · {group.length} ejercicios encadenados
              </p>
              <ul>
                {group.map((block) => (
                  <BlockRow
                    block={block}
                    catalog={catalog}
                    position={(position += 1)}
                    from={{ week: week.order, day: day.order }}
                  />
                ))}
              </ul>
            </div>
          ),
        )
      }
    </section>
  </div>
</BaseLayout>
