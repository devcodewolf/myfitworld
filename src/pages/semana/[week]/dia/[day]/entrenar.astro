---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkoutSession from '@/components/session/WorkoutSession.vue';
import { findDay, findWeek, getActiveMesocycle, getExerciseCatalog } from '@/data';
import { PHASE_LABELS } from '@/core/labels';
import { routes } from '@/routes';

/**
 * La única página del mesociclo que no se genera en el build: es lo que
 * escribe tu entreno, así que pide sesión, y la cookie solo se puede mirar
 * cuando la petición llega al servidor.
 *
 * Al salir del prerender desaparece `getStaticPaths`: la semana y el día ya no
 * los reparte el build, llegan en la URL y hay que resolverlos aquí.
 */
export const prerender = false;

const mesocycle = await getActiveMesocycle();
const weekOrder = Number(Astro.params.week);
const dayOrder = Number(Astro.params.day);
const week = Number.isInteger(weekOrder) ? findWeek(mesocycle, weekOrder) : undefined;
const day = week && Number.isInteger(dayOrder) ? findDay(week, dayOrder) : undefined;

// Antes, una semana inventada no tenía archivo y el 404 salía solo. Ahora la
// ruta responde siempre, así que el «no existe» hay que darlo a mano.
if (!week || !day) return new Response(null, { status: 404 });

const mesocycleId = mesocycle.id;
const catalog = await getExerciseCatalog();

// Solo viajan al cliente los ejercicios que aparecen en este día.
const used = new Set(day.blocks.map((block) => block.exerciseId));
const exercises = Object.fromEntries(
  [...catalog.entries()].filter(([id]) => used.has(id)).map(([id, exercise]) => [id, exercise]),
);
---

<BaseLayout
  title={`Entrenando · ${day.title}`}
  description={`Sesión en curso: ${day.title}, semana ${week.order}.`}
>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    {
      /* client:only porque toda la pantalla depende de lo que haya guardado en
        este navegador: no hay nada útil que renderizar en el servidor. */
    }
    <WorkoutSession
      client:only="vue"
      day={day}
      exercises={exercises}
      mesocycleId={mesocycleId}
      weekOrder={week.order}
      dayOrder={day.order}
      weekLabel={`Semana ${String(week.order).padStart(2, '0')} · ${PHASE_LABELS[week.phase]}`}
      backHref={routes.day(week.order, day.order)}
      homeHref={routes.home()}
      historyHref={routes.history()}
    />
  </div>
</BaseLayout>
