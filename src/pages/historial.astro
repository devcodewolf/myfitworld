---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PhotoCard from '@/components/ui/PhotoCard.astro';
import { getActiveMesocycle, getExerciseCatalog } from '@/data';
import { trackedBlocksOf } from '@/core/history';
import { PHASE_LABELS } from '@/core/labels';
import { daySetCount } from '@/core/training';
import { PHASE_PALETTE, dayPhoto } from '@/theme';
import { routes } from '@/routes';

const mesocycle = await getActiveMesocycle();
const catalog = await getExerciseCatalog();

// El plan entero: lo usan el estado vacío y el calendario de sesiones.
const plan = mesocycle.weeks.map((week) => ({
  order: week.order,
  phase: week.phase,
  days: week.days.map((day) => ({
    order: day.order,
    title: day.title,
    sets: daySetCount(day),
    href: routes.day(week.order, day.order),
    photo: dayPhoto(week.order, day.order),
  })),
}));
const firstDay = plan[0]?.days[0];

// Solo viaja al cliente lo que la pantalla necesita: los músculos y el nombre
// de cada ejercicio, los bloques con rango y la forma del plan.
const payload = {
  muscles: Object.fromEntries(
    [...catalog.entries()].map(([id, exercise]) => [
      id,
      { primaryMuscles: exercise.primaryMuscles, secondaryMuscles: exercise.secondaryMuscles },
    ]),
  ),
  names: Object.fromEntries([...catalog.entries()].map(([id, exercise]) => [id, exercise.name])),
  blocks: trackedBlocksOf(mesocycle),
  phases: Object.fromEntries(mesocycle.weeks.map((week) => [week.order, week.phase])),
  plan: plan.map((week) => ({
    order: week.order,
    days: week.days.map((day) => ({ order: day.order, title: day.title, href: day.href })),
  })),
};

const CELL = 'panel flex min-w-0 flex-col rounded-card border border-line p-5 sm:p-6';
const CELL_TITLE = 'flex items-center gap-2.5 text-base font-extrabold text-ink';
---

<BaseLayout
  title="Historial · My Fitness World"
  description="Sesiones completadas, volumen por semana y avisos de progresión."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <header>
      <h1 class="text-figure font-black tracking-[-0.02em] text-ink">Historial</h1>
      <p class="mt-1 text-sm text-ink-dim">Lo que has entrenado de verdad, sesión a sesión.</p>
    </header>

    <p
      id="fallo"
      hidden
      role="alert"
      class="mt-8 rounded-card border border-line-strong px-4 py-3 text-sm text-ink-dim"
    >
    </p>

    {
      /* Estado vacío: enseña la forma de lo que va a llegar en vez de decir que
        no hay nada. Las doce sesiones del mesociclo, esperando. */
    }
    <div id="vacio" hidden class="grid gap-4 pt-8 lg:grid-cols-3">
      {
        firstDay && (
          <PhotoCard
            photo={firstDay.photo}
            alt=""
            href={firstDay.href}
            eager
            fill
            class="min-h-88 lg:col-span-2 lg:row-span-2"
          >
            <p class="figures text-sm font-bold text-ink-dim">Tu primera sesión</p>
            <h2 class="mt-1 text-figure font-black tracking-[-0.02em] text-balance text-ink">
              {firstDay.title}
            </h2>
            <span class="accion-primaria mt-5 inline-flex min-h-14 items-center rounded-full px-7 text-base font-extrabold text-accent-ink transition-transform group-hover:scale-[1.02]">
              Empezar por aquí
            </span>
          </PhotoCard>
        )
      }

      {
        plan.map((week) => (
          <section
            class:list={[
              'panel rounded-card border border-line p-5',
              PHASE_PALETTE[week.phase].wash,
            ]}
          >
            <h2 class="figures flex items-center gap-2.5 text-sm font-bold text-ink">
              <span
                class:list={['h-4 w-1 rounded-full', PHASE_PALETTE[week.phase].mark]}
                aria-hidden="true"
              />
              Semana {String(week.order).padStart(2, '0')}
              <span class:list={['font-semibold', PHASE_PALETTE[week.phase].text]}>
                {PHASE_LABELS[week.phase]}
              </span>
            </h2>
            <ul class="mt-3 flex flex-col divide-y divide-line border-t border-line">
              {week.days.map((day) => (
                <li>
                  <a
                    href={day.href}
                    class="flex items-baseline justify-between gap-4 py-2.5 text-sm transition-colors hover:text-ink"
                  >
                    <span class="font-bold text-ink-dim">{day.title}</span>
                    <span class="figures shrink-0 text-xs text-ink-faint">{day.sets} series</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <p class="panel rounded-card border border-line p-5 text-sm leading-relaxed text-ink-dim">
        Son doce sesiones. Según las vayas terminando, cada una se llena con lo que hiciste de
        verdad, y este sitio pasa a enseñar el volumen por grupo muscular, tus sesiones una a una y
        el aviso de cuándo toca subir peso.
      </p>
    </div>

    {
      /* Con datos. Bento de tres bandas: primero la respuesta que traes —¿voy a
        más o a menos?—, luego dónde has entrenado, y al final el reparto por
        músculo, que es lo que se consulta cuando ya sabes lo demás. */
    }
    <div id="panel-historial" hidden class="grid gap-4 pt-8 lg:grid-cols-3">
      <PhotoCard
        photo={plan[0]?.days[0]?.photo ?? ''}
        alt=""
        eager
        fill
        class="min-h-72 min-w-0 lg:col-span-2"
      >
        <p class="figures text-sm font-bold text-ink" id="resumen-encabezado"></p>
        <p
          id="resumen-titular"
          class="mt-1 text-figure font-black tracking-[-0.02em] text-balance text-ink"
        >
        </p>
        <dl id="resumen-cifras" class="mt-5 flex flex-wrap gap-x-8 gap-y-3"></dl>
      </PhotoCard>

      <section class:list={[CELL]} aria-labelledby="titulo-avisos">
        <h2 id="titulo-avisos" class={CELL_TITLE}>
          <Icon name="trend-up" size={20} class="text-ink-faint" />
          Toca subir peso
        </h2>
        <div id="avisos" class="mt-4 flex flex-1 flex-col"></div>
      </section>

      <section class:list={[CELL, 'lg:col-span-3']} aria-labelledby="titulo-sesiones">
        <h2 id="titulo-sesiones" class={CELL_TITLE}>
          <Icon name="calendar" size={20} class="text-ink-faint" />
          Tus sesiones
        </h2>
        <p class="mt-2 text-sm text-ink-faint">
          Las doce del mesociclo. Las hechas llevan lo que registraste; las que faltan, su enlace.
        </p>
        <div id="calendario" class="mt-5"></div>
      </section>

      {
        /* La puerta al análisis. Va aquí y no en la navegación porque se pide
          mirando estos datos, que son los que el modelo leería. */
      }
      <a
        href={routes.advice()}
        class:list={[CELL, 'group transition-colors hover:border-line-strong lg:col-span-3']}
      >
        <h2 class={CELL_TITLE}>
          <Icon name="spark" size={20} class="text-ink-faint" />
          Pedir consejo sobre tu entreno
        </h2>
        <p class="mt-2 max-w-[70ch] text-sm text-ink-dim">
          Un modelo lee lo que llevas registrado y sugiere qué ajustar o qué ejercicios incorporar.
          Todavía no funciona: entra para ver qué datos saldrían de tu dispositivo cuando lo haga.
        </p>
        <span
          class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-ink-dim transition-colors group-hover:text-ink"
        >
          Ver la propuesta
          <Icon name="arrow-right" size={16} />
        </span>
      </a>

      <section class:list={[CELL, 'lg:col-span-3']} aria-labelledby="titulo-volumen">
        <h2 id="titulo-volumen" class={CELL_TITLE}>
          <Icon name="bars" size={20} class="text-ink-faint" />
          Series por grupo muscular
        </h2>
        <p class="mt-2 max-w-[70ch] text-sm text-ink-faint">
          Las secundarias cuentan media serie. Todas las semanas se miden con la misma escala, así
          que dos barras del mismo largo son la misma cantidad de trabajo.
        </p>
        <div id="matriz" class="mt-5 overflow-x-auto"></div>
      </section>
    </div>
  </div>
</BaseLayout>

<script id="datos-historial" type="application/json" is:inline set:html={JSON.stringify(payload)} />

<script>
  import { mountHistoryPage, type HistoryPayload } from '@/browser/history-page';

  // Sin esto, cualquier fallo al leer los datos deja la pantalla en blanco y
  // sin explicación, que es peor que un mensaje feo.
  try {
    const raw = document.getElementById('datos-historial')?.textContent ?? '{}';
    await mountHistoryPage(JSON.parse(raw) as HistoryPayload);
  } catch (error) {
    const box = document.getElementById('fallo');
    if (box) {
      box.hidden = false;
      box.textContent = `No se pudo leer el historial: ${error instanceof Error ? error.message : String(error)}`;
    }
  }
</script>
