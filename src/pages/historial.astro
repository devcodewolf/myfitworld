---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Historial · My Fitness World"
  description="Sesiones completadas y evolución de tus pesos."
>
  <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8 lg:px-12 lg:py-16">
    <h1 class="text-display font-black text-ink">Historial</h1>
    <p class="mt-6 max-w-[55ch] text-lg leading-relaxed text-ink-dim">
      Aún no hay ninguna sesión registrada. En cuanto entrenes con el modo entreno, aquí verás cada
      sesión completada, el volumen por grupo muscular y la evolución de tus pesos.
    </p>
  </div>
</BaseLayout>
