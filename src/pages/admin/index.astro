---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountTable from '@/components/admin/AccountTable.astro';
import { MIN_PASSWORD_LENGTH } from '@/auth-contract';
import { routes } from '@/routes';

/**
 * Administración de cuentas.
 *
 * Fuera del prerender, y además **el middleware devuelve 404 a quien no sea
 * administrador**: no un «prohibido», que confirmaría que aquí hay algo.
 *
 * Esta página no decide nada sobre permisos. Cada acción los comprueba por su
 * cuenta en el servidor; esconder un botón no es seguridad.
 */
export const prerender = false;

/** Campo de formulario, con el `input` de daisyUI vestido de la casa. */
const FIELD =
  'input w-full rounded-full border-line bg-ground text-ink transition-colors hover:border-line-strong focus:border-line-strong';
/** El galón del desplegable vive en global.css: la URL del SVG no cabe en una clase. */
const CHEVRON = 'desplegable pr-11';
---

<BaseLayout title="Cuentas · My Fitness World" description="Administración de cuentas.">
  <AccountTable
    title="Cuentas"
    description="Quién tiene acceso, con qué rol y en qué estado. «Entrar como» abre una sesión a nombre de esa persona durante media hora y queda registrado."
    otherHref={routes.adminTrash()}
    otherLabel="Ver la papelera"
    empty="No hay ninguna cuenta activa."
  >
    <div slot="aside">
      <h2 class="text-base font-extrabold text-ink">Crear una cuenta</h2>
      <p class="mt-2 text-sm text-ink-dim">
        Creada desde aquí no hace falta código de invitación: el código existe para que nadie se
        registre solo, no para ti.
      </p>

      {
        /* Dos columnas en cuanto hay sitio: son cuatro campos cortos y en una
          sola fila el panel quedaba larguísimo al lado de una tabla de dos filas. */
      }
      <form id="form-cuenta" class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Nombre</span>
          <input name="nombre" type="text" required maxlength="40" class={FIELD} />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Rol</span>
          <select name="rol" class={`${FIELD} ${CHEVRON}`}>
            <option value="user">Usuario</option>
            <option value="admin">Admin</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Correo</span>
          <input name="correo" type="email" required class={FIELD} />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Contraseña</span>
          <input
            name="clave"
            type="password"
            required
            minlength={MIN_PASSWORD_LENGTH}
            autocomplete="new-password"
            class={FIELD}
          />
          <span class="text-sm text-ink-faint">Mínimo {MIN_PASSWORD_LENGTH} caracteres.</span>
        </label>
        <button
          type="submit"
          class="accion-primaria mt-1 inline-flex min-h-12 items-center justify-center rounded-full px-6 text-sm font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100 sm:col-span-2"
        >
          Crear cuenta
        </button>
      </form>
    </div>
  </AccountTable>
</BaseLayout>

<script>
  import { mountAdminPage } from '@/screens/admin';

  try {
    await mountAdminPage(false);
  } catch (error) {
    const box = document.getElementById('fallo');
    if (box) {
      box.hidden = false;
      box.textContent = `No se pudo cargar la lista: ${error instanceof Error ? error.message : String(error)}`;
    }
  }
</script>
