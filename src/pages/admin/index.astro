---
import { actions } from 'astro:actions';

import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountTable from '@/components/admin/AccountTable.astro';
import { MIN_PASSWORD_LENGTH } from '@/auth-contract';
import { routes } from '@/routes';

/**
 * Administración de cuentas.
 *
 * Fuera del prerender, y además **el middleware devuelve 404 a quien no sea
 * administrador**: no un «prohibido», que confirmaría que aquí hay algo.
 *
 * Esta página no decide nada sobre permisos. Cada acción los comprueba por su
 * cuenta en el servidor; esconder un botón no es seguridad.
 */
export const prerender = false;

/**
 * La lista viaja DENTRO de la página.
 *
 * El servidor ya tenía las cuentas delante al montar esto. Mandar la tabla
 * vacía y esperar a que el navegador las pidiera otra vez era un viaje de ida y
 * vuelta de más, y se notaba: la tabla aparecía en blanco y daba un salto al
 * llenarse casi un segundo después.
 *
 * `Astro.callAction` llama a la misma acción que usaría el cliente, así que la
 * comprobación de permisos es exactamente la misma y no hay una segunda
 * consulta que mantener al día.
 */
const { data: cuentas } = await Astro.callAction(actions.admin.list, { trashed: false });

/** El código de invitación, por el mismo motivo: sin viaje extra al cargar. */
const { data: invitacion } = await Astro.callAction(actions.admin.getInviteCode, undefined);

/** Campo de formulario, con el `input` de daisyUI vestido de la casa. */
const FIELD =
  'input w-full rounded-full border-line bg-ground text-ink transition-colors hover:border-line-strong focus:border-line-strong';
/** El galón del desplegable vive en global.css: la URL del SVG no cabe en una clase. */
const CHEVRON = 'desplegable pr-11';
---

<BaseLayout title="Cuentas · My Fitness World" description="Administración de cuentas.">
  <AccountTable
    title="Cuentas"
    description="Quién tiene acceso, con qué rol y en qué estado. «Entrar como» abre una sesión a nombre de esa persona durante media hora y queda registrado."
    otherHref={routes.adminTrash()}
    otherLabel="Ver la papelera"
    empty="No hay ninguna cuenta activa."
  >
    <div slot="aside">
      <h2 class="text-base font-extrabold text-ink">Crear una cuenta</h2>
      <p class="mt-2 text-sm text-ink-dim">
        Creada desde aquí no hace falta código de invitación: el código existe para que nadie se
        registre solo, no para ti.
      </p>

      {
        /* Dos columnas en cuanto hay sitio: son cuatro campos cortos y en una
          sola fila el panel quedaba larguísimo al lado de una tabla de dos filas. */
      }
      <form id="form-cuenta" class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Nombre</span>
          <input name="nombre" type="text" required maxlength="40" class={FIELD} />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Rol</span>
          <select name="rol" class={`${FIELD} ${CHEVRON}`}>
            <option value="user">Usuario</option>
            <option value="admin">Admin</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Correo</span>
          <input name="correo" type="email" required class={FIELD} />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-bold text-ink-dim">Contraseña</span>
          <input
            name="clave"
            type="password"
            required
            minlength={MIN_PASSWORD_LENGTH}
            autocomplete="new-password"
            class={FIELD}
          />
          <span class="text-sm text-ink-faint">Mínimo {MIN_PASSWORD_LENGTH} caracteres.</span>
        </label>
        <button
          type="submit"
          class="accion-primaria mt-1 inline-flex min-h-12 items-center justify-center rounded-full px-6 text-sm font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100 sm:col-span-2"
        >
          Crear cuenta
        </button>
      </form>
      {
        /**
         * El código de invitación se cambia aquí y no en el entorno porque es
         * lo que acaba pasando con un código: que alguien lo comparte. Tener
         * que redesplegar para rotarlo garantiza que no se rote.
         */
      }
      <section class="mt-4 border-t border-line pt-6">
        <h2 class="text-base font-extrabold text-ink">Código de invitación</h2>
        <p class="mt-2 text-sm text-ink-dim">
          Hace falta para crear una cuenta desde la pantalla de entrada. Si se ha corrido más de la
          cuenta, cámbialo aquí: las cuentas que ya existen no se ven afectadas.
        </p>

        <form id="form-invitacion" class="mt-5 flex flex-col gap-3">
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="font-bold text-ink-dim">El que vale ahora</span>
            <input
              id="codigo"
              name="codigo"
              type="text"
              maxlength="120"
              autocomplete="off"
              spellcheck="false"
              value={invitacion?.code ?? ''}
              class={`${FIELD} figures`}
            />
          </label>
          <p class="text-sm text-ink-faint">
            Ocho caracteres o más. <span class="text-ink-dim"
              >Déjalo vacío para cerrar el registro</span
            >: nadie podrá crear una cuenta hasta que pongas uno nuevo.
          </p>

          <div class="flex flex-wrap gap-2">
            <button
              type="submit"
              class="btn h-11 min-h-11 rounded-full border-line bg-surface px-5 font-bold text-ink hover:border-line-strong hover:bg-raised"
            >
              Guardar
            </button>
            <button
              id="generar-codigo"
              type="button"
              class="btn h-11 min-h-11 rounded-full border-line bg-transparent px-5 font-semibold text-ink-dim hover:border-line-strong hover:bg-raised hover:text-ink"
            >
              Generar uno
            </button>
          </div>
        </form>
      </section>
    </div>
  </AccountTable>
</BaseLayout>

<script
  id="datos-admin"
  type="application/json"
  is:inline
  set:html={JSON.stringify({ trashed: false, cuentas: cuentas ?? [] })}
/>

<script>
  import { mountAdminPage, type AdminPayload } from '@/screens/admin';

  try {
    const raw = document.getElementById('datos-admin')?.textContent ?? '{}';
    await mountAdminPage(JSON.parse(raw) as AdminPayload);
  } catch (error) {
    const box = document.getElementById('fallo');
    if (box) {
      box.hidden = false;
      box.textContent = `No se pudo cargar la lista: ${error instanceof Error ? error.message : String(error)}`;
    }
  }
</script>
