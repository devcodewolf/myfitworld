---
/**
 * TEMPORAL — una página para copiar los prompts de vídeo de cada ejercicio.
 *
 * Bajo `/admin` y fuera del prerender a propósito: así el middleware le da 404
 * a quien no sea administrador, y si se nos olvida borrarla antes de
 * desplegar, no queda a la vista de nadie.
 *
 * Se borra con `_video-prompts.ts` y `routes.adminVideoPrompts`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getExerciseCatalog } from '@/data';
import {
  IMAGE_REFERENCE_PROMPT,
  VIDEO_PROMPTS,
  buildPrompt,
  type PromptStatus,
} from './_video-prompts';

export const prerender = false;

const catalog = await getExerciseCatalog();

/** Un id mal escrito daría un vídeo que luego no casa con nada: mejor romper aquí. */
function nameOf(id: string, name?: string): string {
  const found = name ?? catalog.get(id)?.name;
  if (!found) throw new Error(`El ejercicio «${id}» no existe en el catálogo y no trae nombre.`);
  return found;
}

const GROUPS: readonly { status: PromptStatus; title: string; text: string }[] = [
  {
    status: 'new',
    title: 'Nuevos',
    text: 'Ejercicios que entran en la rutina. Empieza por aquí.',
  },
  {
    status: 'redo',
    title: 'Rehacer',
    text: 'Ya hay vídeo, pero sale mal. En cada tarjeta pone qué falla.',
  },
  {
    status: 'pending',
    title: 'Faltan',
    text: 'De los que ya tenías, los que todavía no tienen vídeo nuevo.',
  },
  {
    status: 'optional',
    title: 'Depende del material',
    text: 'Solo si compras lo que piden. No los generes todavía.',
  },
];

const cards = VIDEO_PROMPTS.map((p) => ({
  ...p,
  title: nameOf(p.id, p.name),
  prompt: buildPrompt(p),
}));

const PROMPT_BOX =
  'mt-3 rounded-box border border-line bg-shade p-4 font-mono text-xs leading-relaxed text-ink-dim select-all';
const COPY_BTN =
  'btn h-10 min-h-10 rounded-full border-line bg-surface px-4 text-sm font-bold text-ink hover:border-line-strong hover:bg-raised';
---

<BaseLayout
  title="Prompts de vídeo · My Fitness World"
  description="Temporal: prompts para generar los vídeos."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-black tracking-[-0.03em] text-ink">Prompts de vídeo</h1>
    <p class="mt-3 max-w-[65ch] text-ink-dim">
      Página temporal, y solo con los vídeos que faltan: los que ya salieron bien están enganchados
      en su ejercicio y su prompt se ha quitado. Cada prompt está completo: cópialo entero y pégalo
      en la IA de vídeo, en 16:9 y de 8 a 10 segundos.
    </p>

    <ol class="mt-6 list-decimal space-y-2 pl-5 text-sm text-ink-dim">
      <li>
        <span class="font-bold text-ink">Primero genera la imagen del personaje</span> con el prompt de
        abajo y quédate con la que te guste. Si tu IA admite «imagen a vídeo» o «personaje de referencia»,
        úsala en todos los vídeos: es la única forma de que salga siempre el mismo hombre.
      </li>
      <li>
        Genera cada ejercicio. Si una repetición sale con la técnica mal, descártalo: se va a ver en
        bucle.
      </li>
      <li>
        Guárdalo como <code class="text-ink">public/ejercicios/&lt;nombre&gt;.mp4</code>, con el
        nombre que pone en cada tarjeta, y dime cuáles tienes: los engancho yo.
      </li>
    </ol>

    <section class="panel mt-8 rounded-card border border-line p-5 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-extrabold text-ink">Imagen de referencia del personaje</h2>
        <button type="button" class={COPY_BTN} data-copiar="ref">Copiar</button>
      </div>
      <p id="ref" class={PROMPT_BOX}>{IMAGE_REFERENCE_PROMPT}</p>
    </section>

    {
      // Un grupo sin tarjetas se calla: un título encima de nada parece un fallo.
      GROUPS.filter((group) => cards.some((card) => card.status === group.status)).map((group) => (
        <section class="mt-12">
          <h2 class="text-2xl font-extrabold text-ink">{group.title}</h2>
          <p class="mt-1 text-sm text-ink-faint">{group.text}</p>
          <ul class="mt-5 space-y-4">
            {cards
              .filter((card) => card.status === group.status)
              .map((card) => (
                <li class="panel rounded-card border border-line p-5 sm:p-6">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h3 class="text-lg font-extrabold text-ink">{card.title}</h3>
                      <p class="mt-1 font-mono text-xs text-ink-faint">
                        public/ejercicios/{card.id}.mp4
                      </p>
                    </div>
                    <button type="button" class={COPY_BTN} data-copiar={`p-${card.id}`}>
                      Copiar
                    </button>
                  </div>
                  <p class="mt-3 text-sm text-ink-dim">{card.why}</p>
                  {card.note && <p class="mt-2 text-sm text-ink-faint">{card.note}</p>}
                  {card.startFrame && (
                    <div class="mt-4">
                      <div class="flex flex-wrap items-center justify-between gap-3">
                        <h4 class="text-sm font-extrabold text-ink">1 · Foto de partida</h4>
                        <button type="button" class={COPY_BTN} data-copiar={`f-${card.id}`}>
                          Copiar
                        </button>
                      </div>
                      <p id={`f-${card.id}`} class={PROMPT_BOX}>
                        {card.startFrame}
                      </p>
                      <h4 class="mt-4 text-sm font-extrabold text-ink">2 · Vídeo desde esa foto</h4>
                    </div>
                  )}
                  <p id={`p-${card.id}`} class={PROMPT_BOX}>
                    {card.prompt}
                  </p>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  // Copiar al portapapeles. Si el navegador no deja, el texto ya es
  // seleccionable de un clic (`select-all`), así que no se queda nadie sin él.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copiar ?? '')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copiado';
      } catch {
        button.textContent = 'Selecciónalo a mano';
      }
      setTimeout(() => (button.textContent = 'Copiar'), 1800);
    });
  }
</script>
