---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DayCard from '@/components/routine/DayCard.astro';
import WeekNav from '@/components/routine/WeekNav.astro';
import WeekRow from '@/components/routine/WeekRow.astro';
import PhotoCard from '@/components/ui/PhotoCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { getActiveMesocycle, getExerciseCatalog } from '@/data';
import { PHASE_LABELS, formatDuration } from '@/core/labels';
import { daySetCount, estimateDaySeconds } from '@/core/training';
import { routes } from '@/routes';
import { PHASE_PALETTE, TODAY_PHOTO } from '@/theme';

const mesocycle = await getActiveMesocycle();
const catalog = await getExerciseCatalog();

// El estado real de cada semana vive en el historial, que aún no existe: hasta
// que exista la capa de persistencia, la sesión pendiente es la primera.
const currentWeek = mesocycle.weeks[0]!;
const nextDay = currentWeek.days[0]!;
const restDays = currentWeek.days.slice(1);
const palette = PHASE_PALETTE[currentWeek.phase];
const totalSessions = mesocycle.weeks.reduce((total, week) => total + week.days.length, 0);
const nextChips = [
  `${daySetCount(nextDay)} series`,
  `${nextDay.blocks.length} ejercicios`,
  formatDuration(estimateDaySeconds(nextDay, catalog)),
];
---

<BaseLayout title={`${mesocycle.name} · My Fitness World`} description={mesocycle.description}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
      <header class="min-w-0">
        <div>
          <h1 class="text-figure font-black tracking-[-0.02em] text-ink">
            {mesocycle.name}
          </h1>
          <p class="figures mt-1 text-sm text-ink-dim">
            {mesocycle.weeks.length} semanas · {totalSessions} sesiones · aún no has registrado ninguna
          </p>
        </div>
      </header>

      <WeekNav mesocycle={mesocycle} activeWeek={currentWeek.order} />
    </div>

    {
      /* La sesión que toca ocupa dos tercios y manda; los otros dos días se
			apilan a su derecha y adoptan entre los dos su misma altura. */
    }
    <p class:list={['text-sm font-bold', palette.text]}>
      Semana {String(currentWeek.order).padStart(2, '0')} · {PHASE_LABELS[currentWeek.phase]}
    </p>
    <section
      class="grid gap-5 pt-4 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]"
      aria-labelledby="siguiente"
    >
      <h2 id="siguiente" class="sr-only">Tu próxima sesión</h2>
      <PhotoCard photo={TODAY_PHOTO} alt="" eager fill class="min-h-76">
        <h3 class="text-6xl font-black tracking-[-0.03em] text-balance text-ink">
          {nextDay.title}
        </h3>
        <p class="figures mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-bold">
          <span class="h-0.5 w-6 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="text-accent">Tu próxima sesión</span>
          <span class="text-ink-dim">
            Semana {String(currentWeek.order).padStart(2, '0')} · Día {nextDay.order}
          </span>
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <a
            href={routes.day(currentWeek.order, nextDay.order)}
            class="accion-primaria inline-flex min-h-14 items-center gap-3 rounded-full px-7 text-base font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100"
          >
            Ver la sesión
            <Icon name="arrow-right" size={20} class="shrink-0" />
          </a>
          <ul class="figures flex flex-wrap gap-2">
            {
              nextChips.map((chip) => (
                <li class="rounded-full border border-line bg-[color-mix(in_oklab,var(--color-ground)_65%,transparent)] px-3.5 py-1.5 text-sm font-semibold text-ink backdrop-blur-sm">
                  {chip}
                </li>
              ))
            }
          </ul>
        </div>
      </PhotoCard>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {
          restDays.map((day) => (
            <DayCard
              day={day}
              weekOrder={currentWeek.order}
              phase={currentWeek.phase}
              catalog={catalog}
              ratio="16/9"
            />
          ))
        }
      </div>
    </section>

    <section class="pt-12" aria-labelledby="plan">
      <h2 id="plan" class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase">
        Las cuatro semanas
      </h2>
      <div class="mt-4">
        {mesocycle.weeks.map((week) => <WeekRow week={week} catalog={catalog} />)}
      </div>
    </section>
  </div>
</BaseLayout>
