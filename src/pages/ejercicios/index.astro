---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExerciseMedia from '@/components/exercise/ExerciseMedia.astro';
import { getExerciseCatalog } from '@/data';
import { DIFFICULTY_LABELS, MUSCLE_LABELS } from '@/core/labels';
import { routes } from '@/routes';

const catalog = await getExerciseCatalog();
const exercises = [...catalog.values()].sort((a, b) => a.name.localeCompare(b.name, 'es'));
---

<BaseLayout
  title="Ejercicios · My Fitness World"
  description="Catálogo de los ejercicios del mesociclo, con sus claves de técnica."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <header>
      <h1 class="text-figure font-black tracking-[-0.02em] text-ink">Ejercicios</h1>
      <p class="figures mt-1 text-sm text-ink-dim">
        {exercises.length} ejercicios en el catálogo del mesociclo
      </p>
    </header>

    {
      /* El croquis manda en la tarjeta: ocupa el ancho completo y el texto se
        reduce a lo que hace falta para elegir. Dos columnas en escritorio para
        que la imagen tenga tamaño de verdad. */
    }
    <ul class="grid gap-5 pt-7 sm:grid-cols-2 xl:grid-cols-3">
      {
        exercises.map((exercise) => (
          <li>
            <a
              href={routes.exercise(exercise.id)}
              class="panel group flex h-full flex-col overflow-hidden rounded-card border border-line transition-colors hover:border-line-strong"
            >
              <ExerciseMedia
                label={exercise.name}
                asset={exercise.media?.thumbnail ?? exercise.media?.video}
                ratio="3/2"
                class="rounded-none border-0 border-b border-line"
              />
              <div class="flex flex-1 flex-col p-5">
                <h2 class="text-lg font-bold text-ink">{exercise.name}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {exercise.primaryMuscles.slice(0, 2).map((muscle) => (
                    <li class="rounded-full border border-line px-3 py-1 text-xs font-semibold text-ink-dim">
                      {MUSCLE_LABELS[muscle]}
                    </li>
                  ))}
                  <li class="rounded-full border border-line px-3 py-1 text-xs font-semibold text-ink-faint">
                    {DIFFICULTY_LABELS[exercise.difficulty]}
                  </li>
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
