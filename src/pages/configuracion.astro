---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes } from '@/routes';
import { SCENE_PHOTOS } from '@/theme';

/**
 * Fuera del prerender: pide sesión, y la cookie solo se puede mirar cuando la
 * petición llega al servidor. Una página generada en el build es el mismo
 * archivo para todo el mundo, sin sitio donde comprobar quién la pide.
 */
export const prerender = false;

/**
 * Interruptor construido sobre el propio checkbox: sigue siendo un checkbox
 * para el teclado, para el lector de pantalla y para el script que lo lee, y
 * solo cambia de piel. Encendido va en tinta, no en acento: el cian está
 * reservado a la acción primaria y a lo que toca ahora, y cuatro interruptores
 * encendidos lo gastarían.
 */
const SWITCH =
  'relative h-7 w-12 shrink-0 cursor-pointer appearance-none rounded-full border border-line-strong bg-surface transition-colors before:absolute before:top-0.5 before:left-0.5 before:size-5 before:rounded-full before:bg-ink-faint before:transition-transform before:content-[""] checked:border-ink checked:bg-ink checked:before:translate-x-5 checked:before:bg-ground';

/** El galón del desplegable vive en global.css: la URL del SVG no cabe en una clase. */
const CHEVRON = 'desplegable pr-11';

/** Campos de formulario: mismo alto, mismo radio, sin cromo del sistema operativo. */
const FIELD =
  'min-h-11 rounded-full border border-line bg-surface px-4 text-ink transition-colors hover:border-line-strong';

/** Celda del bento. La rejilla decide el tamaño; la celda, el material. */
const CELL = 'panel flex flex-col rounded-card border border-line';

/** Título de celda. No es un eyebrow: es el encabezado de su propia celda. */
const CELL_TITLE = 'text-base font-extrabold text-ink';

const toggles = [
  { id: 'sonido', label: 'Avisos sonoros', hint: 'Pitidos de inicio de serie y fin de descanso.' },
  { id: 'vibracion', label: 'Vibración', hint: 'Acompaña a cada aviso en el móvil.' },
  {
    id: 'pantalla',
    label: 'Mantener la pantalla encendida',
    hint: 'Mientras entrenas, si el navegador lo permite.',
  },
  {
    id: 'descanso-auto',
    label: 'Empezar el descanso solo',
    hint: 'Al marcar una serie arranca la cuenta atrás sin tocar nada.',
  },
];
---

<BaseLayout
  title="Ajustes · My Fitness World"
  description="Material disponible, sonido, descansos y copia de seguridad."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <header>
      <h1 class="text-figure font-black tracking-[-0.02em] text-ink">Ajustes</h1>
      <p class="mt-1 text-sm text-ink-dim">Se guardan en este navegador en cuanto los cambias.</p>
    </header>

    <p
      id="aviso"
      hidden
      role="status"
      class="mt-6 rounded-card border border-line px-4 py-3 text-sm text-ink data-[tone=error]:border-line-strong data-[tone=error]:text-ink-dim"
    >
    </p>

    {
      /* Bento. El material ocupa la celda mayor porque es de donde sale cada
        peso que la app te sugiere durante el entreno: sin él, no sugiere nada. */
    }
    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      <section
        class:list={[CELL, 'overflow-hidden lg:col-span-2 lg:row-span-2']}
        aria-labelledby="material"
      >
        <img
          src={SCENE_PHOTOS.floor}
          alt=""
          loading="eager"
          decoding="async"
          class="h-36 w-full border-b border-line object-cover sm:h-44"
        />
        <div class="flex flex-1 flex-col p-5 sm:p-6">
          <h2 id="material" class={CELL_TITLE}>Material disponible</h2>
          <p class="mt-2 max-w-[60ch] text-sm text-ink-dim">
            De aquí sale el siguiente salto de peso que te sugiere la app. Si no está declarado, no
            existe.
          </p>

          <ul id="lista-material" class="mt-5 space-y-2"></ul>
          <p id="resumen-cargas" class="figures mt-3 text-sm text-ink-faint"></p>

          <form id="form-material" class="mt-5 flex flex-wrap items-end gap-3">
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-ink-dim">Tipo</span>
              <select name="tipo" class={`${FIELD} ${CHEVRON}`}>
                <option value="dumbbell">Mancuerna</option>
                <option value="kettlebell">Kettlebell</option>
                <option value="plate">Disco</option>
                <option value="barbell">Barra</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-ink-dim">Peso (kg)</span>
              <input
                name="peso"
                type="number"
                step="0.5"
                min="0.5"
                required
                class={`${FIELD} figures w-28`}
              />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-ink-dim">Unidades</span>
              <input
                name="unidades"
                type="number"
                step="1"
                min="1"
                value="2"
                required
                class={`${FIELD} figures w-24`}
              />
            </label>
            <button
              type="submit"
              class="accion-primaria min-h-11 rounded-full px-6 text-sm font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100"
            >
              Añadir
            </button>
          </form>
        </div>
      </section>

      <section class:list={[CELL, 'p-5 sm:p-6']} aria-labelledby="peso-corporal-tit">
        <div>
          <h2 id="peso-corporal-tit" class={CELL_TITLE}>Tu peso corporal</h2>
          <p class="mt-2 text-sm text-ink-dim">
            Opcional. Solo se usa para estimar el trabajo de los ejercicios sin carga externa.
          </p>
        </div>
        <label class="mt-6 flex flex-col gap-1.5 text-sm">
          <span class="text-ink-faint">Kilos</span>
          <input
            id="peso-corporal"
            type="number"
            step="0.1"
            min="20"
            max="300"
            class={`${FIELD} figures h-14 w-full !rounded-card text-2xl font-extrabold`}
          />
        </label>
      </section>

      <section class:list={[CELL, 'p-5 sm:p-6']} aria-labelledby="descanso-tit">
        <div>
          <h2 id="descanso-tit" class={CELL_TITLE}>
            <label for="descanso">Descanso entre series</label>
          </h2>
          <p class="mt-2 text-sm text-ink-dim">
            El mismo para todos los ejercicios. También se cambia sobre la marcha desde la pantalla
            de entreno.
          </p>
        </div>
        <div class="mt-6">
          <output id="descanso-valor" class="figures block text-3xl font-extrabold text-ink"
          ></output>
          <input
            id="descanso"
            type="range"
            min="15"
            max="180"
            step="5"
            class="mt-3 w-full accent-[var(--color-ink)]"
          />
        </div>
      </section>

      <section class:list={[CELL, 'p-5 sm:p-6 lg:col-span-2']} aria-labelledby="sesion">
        <h2 id="sesion" class={CELL_TITLE}>Durante la sesión</h2>
        <ul class="mt-4 grid gap-x-6 sm:grid-cols-2">
          {
            toggles.map((toggle) => (
              <li class="flex items-center justify-between gap-4 border-t border-line py-3.5">
                <label for={toggle.id} class="min-w-0">
                  <span class="block text-sm font-bold text-ink">{toggle.label}</span>
                  <span class="block text-sm text-ink-faint">{toggle.hint}</span>
                </label>
                <input id={toggle.id} type="checkbox" role="switch" class={SWITCH} />
              </li>
            ))
          }
        </ul>
      </section>

      {
        /* La cuenta vive aquí y no solo en la barra: la píldora de arriba es un
          atajo, pero el sitio donde se administra algo es su pantalla. */
      }
      <section class:list={[CELL, 'p-5 sm:p-6']} aria-labelledby="cuenta">
        <h2 id="cuenta" class={CELL_TITLE}>Cuenta</h2>
        {
          Astro.locals.user ? (
            <>
              <p class="mt-2 text-sm text-ink-dim">
                Has entrado como <span class="font-bold text-ink">{Astro.locals.user.email}</span>.
              </p>
              <p class="mt-2 text-sm text-ink-faint">
                Tu historial va con la cuenta, no con este navegador.
              </p>
              <form method="POST" action={routes.signOut()} class="mt-5">
                <button
                  type="submit"
                  class="min-h-11 rounded-full border border-line px-6 text-sm font-semibold text-ink-dim transition-colors hover:border-line-strong hover:text-ink"
                >
                  Cerrar sesión
                </button>
              </form>
            </>
          ) : (
            <p class="mt-2 text-sm text-ink-dim">No has entrado.</p>
          )
        }
      </section>

      <section class:list={[CELL, 'p-5 sm:p-6']} aria-labelledby="datos">
        <h2 id="datos" class={CELL_TITLE}>Tus datos</h2>
        <p class="mt-2 max-w-[70ch] text-sm text-ink-dim">
          Tu historial vive en tu cuenta, en el servidor, y se guarda solo. Esta exportación ya no
          es tu única copia: es la que puedes llevarte contigo, y la que te queda si algún día falla
          todo lo demás.
        </p>

        <div class="mt-5 flex flex-wrap items-end gap-3">
          <button
            id="exportar"
            type="button"
            class="accion-primaria min-h-11 rounded-full px-6 text-sm font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100"
          >
            Exportar copia (JSON)
          </button>

          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink-dim">Al importar</span>
            <select id="modo-import" class={`${FIELD} ${CHEVRON}`}>
              <option value="merge">Fusionar con lo que ya tengo</option>
              <option value="replace">Reemplazarlo todo</option>
            </select>
          </label>

          <label
            class="min-h-11 cursor-pointer rounded-full border border-line px-6 py-2.5 text-sm font-semibold text-ink-dim transition-colors hover:border-line-strong hover:text-ink"
          >
            Importar copia
            <input id="importar" type="file" accept="application/json,.json" class="sr-only" />
          </label>
        </div>
        <p class="mt-3 text-sm text-ink-faint">
          Al fusionar nunca se pisa un registro más reciente con uno más antiguo.
        </p>
      </section>

      {
        /* La mudanza. Solo aparece si este navegador guarda algo de la versión
          anterior, y desaparece en cuanto no queda nada que traer: un botón
          permanente para una operación que se hace una vez es ruido. */
      }
      <section
        id="mudanza"
        hidden
        class:list={[CELL, 'p-5 sm:p-6 lg:col-span-2']}
        aria-labelledby="mudanza-tit"
      >
        <h2 id="mudanza-tit" class={CELL_TITLE}>Lo que había en este navegador</h2>
        <p id="mudanza-resumen" class="figures mt-2 max-w-[70ch] text-sm text-ink-dim"></p>
        <p class="mt-2 max-w-[70ch] text-sm text-ink-faint">
          Antes tu entreno se guardaba aquí, en este navegador. Ahora va en tu cuenta. Esto lo sube
          y lo fusiona con lo que ya tengas: no se pisa nada más reciente y no se borra nada de
          aquí, así que puedes repetirlo sin miedo.
        </p>
        <div class="mt-5">
          <button
            id="traer-local"
            type="button"
            class="accion-primaria min-h-11 rounded-full px-6 text-sm font-extrabold text-accent-ink transition-transform hover:scale-[1.02] active:scale-100 disabled:scale-100 disabled:bg-ground disabled:bg-none disabled:text-ink-faint"
          >
            Traer a mi cuenta
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountSettingsPage } from '@/browser/settings-page';

  void mountSettingsPage();
</script>
