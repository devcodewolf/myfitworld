---
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * Interruptor construido sobre el propio checkbox: sigue siendo un checkbox
 * para el teclado, para el lector de pantalla y para el script que lo lee, y
 * solo cambia de piel. Encendido va en tinta, no en acento: el cian está
 * reservado a la acción primaria y a lo que toca ahora, y cuatro interruptores
 * encendidos lo gastarían.
 */
const SWITCH =
  'relative h-7 w-12 shrink-0 cursor-pointer appearance-none rounded-full border border-line-strong bg-surface transition-colors before:absolute before:top-0.5 before:left-0.5 before:size-5 before:rounded-full before:bg-ink-faint before:transition-transform before:content-[""] checked:border-ink checked:bg-ink checked:before:translate-x-5 checked:before:bg-ground';

/** El galón del desplegable vive en global.css: la URL del SVG no cabe en una clase. */
const CHEVRON = 'desplegable pr-11';

/** Campos del formulario de material: mismo alto, mismo radio, sin cromo del SO. */
const FIELD =
  'min-h-11 rounded-full border border-line bg-surface px-4 text-ink transition-colors hover:border-line-strong';

const toggles = [
  { id: 'sonido', label: 'Avisos sonoros', hint: 'Pitidos de inicio de serie y fin de descanso.' },
  { id: 'vibracion', label: 'Vibración', hint: 'Acompaña a cada aviso en el móvil.' },
  {
    id: 'pantalla',
    label: 'Mantener la pantalla encendida',
    hint: 'Mientras entrenas, si el navegador lo permite.',
  },
  {
    id: 'descanso-auto',
    label: 'Empezar el descanso solo',
    hint: 'Al marcar una serie arranca la cuenta atrás sin tocar nada.',
  },
];
---

<BaseLayout
  title="Ajustes · My Fitness World"
  description="Material disponible, sonido, descansos y copia de seguridad."
>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <header>
      <h1 class="text-figure font-black tracking-[-0.02em] text-ink">Ajustes</h1>
      <p class="mt-1 text-sm text-ink-dim">Se guardan en este navegador en cuanto los cambias.</p>
    </header>

    <p
      id="aviso"
      hidden
      role="status"
      class="mt-6 rounded-card border border-line px-4 py-3 text-sm text-ink data-[tone=error]:border-line-strong data-[tone=error]:text-ink-dim"
    >
    </p>

    <section class="mt-10" aria-labelledby="material">
      <h2 id="material" class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase">
        Material disponible
      </h2>
      <p class="mt-3 max-w-[60ch] text-sm text-ink-dim">
        De aquí sale el siguiente salto de peso que te sugiere la app. Si no está declarado, no
        existe.
      </p>

      <ul id="lista-material" class="mt-5 space-y-2"></ul>
      <p id="resumen-cargas" class="figures mt-3 text-sm text-ink-faint"></p>

      <form id="form-material" class="mt-5 flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-ink-dim">Tipo</span>
          <select name="tipo" class={`${FIELD} ${CHEVRON}`}>
            <option value="dumbbell">Mancuerna</option>
            <option value="kettlebell">Kettlebell</option>
            <option value="plate">Disco</option>
            <option value="barbell">Barra</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-ink-dim">Peso (kg)</span>
          <input
            name="peso"
            type="number"
            step="0.5"
            min="0.5"
            required
            class={`${FIELD} figures w-28`}
          />
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-ink-dim">Unidades</span>
          <input
            name="unidades"
            type="number"
            step="1"
            min="1"
            value="2"
            required
            class={`${FIELD} figures w-24`}
          />
        </label>
        <button
          type="submit"
          class="accion-primaria min-h-11 rounded-full px-6 text-sm font-extrabold text-accent-ink"
        >
          Añadir
        </button>
      </form>
    </section>

    <section class="mt-12" aria-labelledby="sesion">
      <h2 id="sesion" class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase">
        Durante la sesión
      </h2>

      <ul class="mt-5 space-y-3">
        {
          toggles.map((toggle) => (
            <li class="flex items-center justify-between gap-6 rounded-card border border-line px-4 py-3">
              <label for={toggle.id} class="min-w-0">
                <span class="block text-sm font-bold text-ink">{toggle.label}</span>
                <span class="block text-sm text-ink-faint">{toggle.hint}</span>
              </label>
              <input id={toggle.id} type="checkbox" role="switch" class={SWITCH} />
            </li>
          ))
        }
      </ul>

      <div class="mt-5 rounded-card border border-line px-4 py-4">
        <label for="descanso" class="text-sm font-bold text-ink"> Descanso entre series </label>
        <p class="mt-1 text-sm text-ink-faint">
          El mismo para todos los ejercicios. También se cambia sobre la marcha desde la pantalla de
          entreno.
        </p>
        <div class="mt-3 flex items-center gap-4">
          <input
            id="descanso"
            type="range"
            min="15"
            max="180"
            step="5"
            class="w-full accent-[var(--color-ink)]"
          />
          <output id="descanso-valor" class="figures w-16 text-right text-sm font-bold text-ink"
          ></output>
        </div>
      </div>

      <div class="mt-5 rounded-card border border-line px-4 py-4">
        <label for="peso-corporal" class="text-sm font-bold text-ink">Tu peso corporal (kg)</label>
        <p class="mt-1 text-sm text-ink-faint">
          Opcional. Solo se usa para estimar el trabajo de los ejercicios sin carga externa.
        </p>
        <input
          id="peso-corporal"
          type="number"
          step="0.1"
          min="20"
          max="300"
          class={`${FIELD} figures mt-3 w-32`}
        />
      </div>
    </section>

    <section class="mt-12" aria-labelledby="datos">
      <h2 id="datos" class="text-[0.72rem] font-bold tracking-[0.2em] text-ink-faint uppercase">
        Tus datos
      </h2>
      <p class="mt-3 max-w-[60ch] text-sm text-ink-dim">
        Todo vive en este navegador. Si lo borras o cambias de ordenador, sin copia no hay
        historial: esta exportación es tu única copia de seguridad.
      </p>

      <div class="mt-5 flex flex-wrap items-end gap-3">
        <button
          id="exportar"
          type="button"
          class="accion-primaria min-h-11 rounded-full px-6 text-sm font-extrabold text-accent-ink"
        >
          Exportar copia (JSON)
        </button>

        <label class="flex flex-col gap-1 text-sm">
          <span class="text-ink-dim">Al importar</span>
          <select id="modo-import" class={`${FIELD} ${CHEVRON}`}>
            <option value="merge">Fusionar con lo que ya tengo</option>
            <option value="replace">Reemplazarlo todo</option>
          </select>
        </label>

        <label
          class="min-h-11 cursor-pointer rounded-full border border-line px-6 py-2.5 text-sm font-semibold text-ink-dim transition-colors hover:border-line-strong hover:text-ink"
        >
          Importar copia
          <input id="importar" type="file" accept="application/json,.json" class="sr-only" />
        </label>
      </div>
      <p class="mt-3 text-sm text-ink-faint">
        Al fusionar nunca se pisa un registro más reciente con uno más antiguo.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountSettingsPage } from '@/browser/settings-page';

  void mountSettingsPage();
</script>
