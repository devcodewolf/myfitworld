---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ajustes · My Fitness World"
  description="Material disponible, sonido, descansos y copia de seguridad."
>
  <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8 lg:px-12 lg:py-16">
    <h1 class="text-display font-black text-ink">Ajustes</h1>
    <p class="mt-6 max-w-[55ch] text-lg leading-relaxed text-ink-dim">
      Aquí vivirán tu material disponible, el interruptor de sonido, el multiplicador de descansos y
      la exportación de tus datos. Llegan con la capa de almacenamiento.
    </p>
  </div>
</BaseLayout>
