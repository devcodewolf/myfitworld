---
/**
 * Tarjeta con fotografía de fondo: la pieza de la que vive esta interfaz.
 *
 * La foto se apaga y se enfría a propósito, y encima cae un degradado desde el
 * fondo de la app. No es decoración: es lo que garantiza que el texto blanco
 * mantenga su contraste sea cual sea la foto que haya debajo, incluida una que
 * traigas tú mañana y que yo no he visto nunca.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo: ImageMetadata;
  alt: string;
  href?: string;
  /** La tarjeta protagonista carga de inmediato; el resto, en diferido. */
  eager?: boolean;
  ratio?: string;
  /** Adopta la altura de su celda en la rejilla en vez de imponer proporción. */
  fill?: boolean;
  class?: string;
}

const {
  photo,
  alt,
  href,
  eager = false,
  ratio = '16/9',
  fill = false,
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group relative isolate flex flex-col justify-end overflow-hidden rounded-card border border-line',
    fill && 'h-full',
    className,
  ]}
  style={fill ? undefined : `aspect-ratio: ${ratio}`}
>
  <Image
    src={photo}
    alt={alt}
    widths={[480, 960]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    class="absolute inset-0 -z-10 size-full object-cover opacity-70 saturate-[0.65] transition-transform duration-500 group-hover:scale-[1.03]"
  />
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-ground)_4%,color-mix(in_oklab,var(--color-ground)_72%,transparent)_46%,color-mix(in_oklab,var(--color-accent)_14%,transparent))]"
  >
  </div>

  <div class="relative p-5 sm:p-6">
    <slot />
  </div>
</Tag>
