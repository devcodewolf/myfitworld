---
/**
 * Tarjeta con fotografía: la pieza de la que vive esta interfaz.
 *
 * La foto va a plena luz y a plena saturación, porque una foto apagada al 70 %
 * deja de leerse como foto y pasa a ser una textura sucia. El contraste del
 * texto no se compra bajando la imagen entera, sino con un velo que solo existe
 * donde hay letras: transparente arriba, opaco abajo. Así el motivo se ve y el
 * texto se lee, sea cual sea la foto que haya debajo, incluida una que traigas
 * tú mañana y que yo no he visto nunca.
 *
 * Acepta las dos procedencias que hay hoy: un archivo del proyecto, que pasa
 * por `astro:assets` y se sirve en dos anchos, y una URL remota, que ya llega
 * dimensionada desde su origen. Quien la usa no tiene que saber cuál es cuál.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo: ImageMetadata | string;
  alt: string;
  href?: string;
  /** La tarjeta protagonista carga de inmediato; el resto, en diferido. */
  eager?: boolean;
  ratio?: string;
  /** Adopta la altura de su celda en la rejilla en vez de imponer proporción. */
  fill?: boolean;
  class?: string;
}

const {
  photo,
  alt,
  href,
  eager = false,
  ratio = '16/9',
  fill = false,
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const remote = typeof photo === 'string';

const IMG =
  'absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]';
---

<Tag
  href={href}
  class:list={[
    'group relative isolate flex flex-col justify-end overflow-hidden rounded-card border border-line',
    fill && 'h-full',
    className,
  ]}
  style={fill ? undefined : `aspect-ratio: ${ratio}`}
>
  {
    remote ? (
      <img src={photo} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class={IMG} />
    ) : (
      <Image
        src={photo}
        alt={alt}
        widths={[480, 960]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class={IMG}
      />
    )
  }
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-ground)_2%,color-mix(in_oklab,var(--color-ground)_88%,transparent)_28%,color-mix(in_oklab,var(--color-ground)_45%,transparent)_58%,transparent_82%)]"
  >
  </div>

  <div class="relative p-5 sm:p-6">
    <slot />
  </div>
</Tag>
