---
/**
 * Única puerta de entrada a la media de un ejercicio.
 *
 * Reserva el hueco por aspect-ratio siempre, así que el layout no salta ni
 * cuando el asset no existe todavía. El vídeo de terceros no carga nada hasta
 * que se pulsa: en modo entreno no puede haber una petición a YouTube por serie.
 */
import type { MediaAsset } from '@/core/model';
import { routes } from '@/routes';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  asset?: MediaAsset;
  /** El ejercicio activo en modo entreno carga de inmediato; el resto, en diferido. */
  eager?: boolean;
  label: string;
  /** Proporción del hueco cuando todavía no hay asset. */
  ratio?: string;
  /** Controles del vídeo. Por defecto, en todas partes menos en modo entreno. */
  controls?: boolean;
  class?: string;
}

const {
  asset,
  eager = false,
  label,
  ratio: ratioProp,
  controls = !eager,
  class: className,
} = Astro.props;
const ratio = ratioProp ?? '4/3';
---

<figure
  class:list={['relative overflow-hidden rounded-card border border-line bg-surface', className]}
  style={`aspect-ratio: ${ratio}`}
>
  {
    asset === undefined && (
      <div class="absolute inset-0 grid place-content-center justify-items-center gap-2 text-center">
        <Icon name="catalog" size={36} class="text-line" />
        <p class="max-w-[26ch] px-4 text-sm text-ink-faint">Sin imagen de {label} todavía.</p>
      </div>
    )
  }

  {
    asset?.kind === 'image' && (
      <img
        src={routes.asset(asset.src)}
        alt={asset.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="size-full object-cover"
      />
    )
  }

  {
    /* La lámina llena el hueco con su propio fondo claro y de borde a borde: es
      material, no una imagen pegada encima del oscuro. */
    asset?.kind === 'plate' && (
      <div class="grid size-full place-items-center bg-plate p-4">
        <img
          src={routes.asset(asset.src)}
          alt={asset.alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="max-h-full w-full max-w-88 object-contain"
        />
      </div>
    )
  }

  {
    asset?.kind === 'croquis' && (
      <img
        src={routes.asset(asset.src)}
        alt={asset.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="size-full object-contain p-4 text-ink"
      />
    )
  }

  {
    asset?.kind === 'video' && (
      <video
        muted
        loop
        playsinline
        autoplay={eager}
        controls={controls}
        data-hover-play={!eager && !controls ? '' : undefined}
        preload={eager ? 'auto' : 'metadata'}
        poster={asset.poster ? routes.asset(asset.poster) : undefined}
        aria-label={asset.alt}
        class="size-full object-cover"
      >
        {asset.sources.map((source) => (
          <source src={routes.asset(source.src)} type={source.type} />
        ))}
      </video>
    )
  }

  {
    asset?.kind === 'embed' && (
      <button
        type="button"
        class="group absolute inset-0 grid place-content-center gap-3 text-center"
        data-embed-provider={asset.provider}
        data-embed-id={asset.videoId}
        data-embed-start={asset.startSeconds ?? 0}
      >
        <span class="mx-auto grid size-16 place-content-center rounded-full bg-ink text-ground transition-transform group-hover:scale-105">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </span>
        <span class="text-sm font-bold text-ink-dim">Ver la ejecución en vídeo</span>
        <span class="sr-only">{asset.alt}</span>
      </button>
    )
  }
</figure>

<script>
  // En una rejilla, un vídeo que se reproduce solo cuesta megabytes por tarjeta
  // y compite con los de al lado. Se despierta al pasar por encima y se rebobina
  // al salir, así que la tarjeta en reposo pesa lo que su primer fotograma.
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((video) => {
    const card = video.closest('a') ?? video.parentElement;
    if (!card) return;
    card.addEventListener('mouseenter', () => void video.play().catch(() => {}));
    card.addEventListener('mouseleave', () => {
      video.pause();
      video.currentTime = 0;
    });
  });

  // El iframe de terceros se crea al pulsar, nunca antes.
  document.querySelectorAll<HTMLButtonElement>('[data-embed-provider]').forEach((button) => {
    button.addEventListener('click', () => {
      const { embedProvider, embedId, embedStart } = button.dataset;
      const iframe = document.createElement('iframe');
      iframe.src =
        embedProvider === 'vimeo'
          ? `https://player.vimeo.com/video/${embedId}?autoplay=1#t=${embedStart}s`
          : `https://www.youtube-nocookie.com/embed/${embedId}?autoplay=1&start=${embedStart}`;
      iframe.allow = 'autoplay; fullscreen';
      iframe.className = 'absolute inset-0 size-full';
      iframe.title = button.querySelector('.sr-only')?.textContent ?? 'Vídeo del ejercicio';
      button.replaceWith(iframe);
    });
  });
</script>
