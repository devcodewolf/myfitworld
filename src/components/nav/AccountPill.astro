---
/**
 * Quién está dentro, en la barra de navegación.
 *
 * Se monta con `server:defer`, o sea como **server island**: la página se
 * sigue generando entera en el build y solo este trozo se pide al servidor al
 * cargarla. Es lo que permite que las páginas estáticas enseñen algo que
 * depende de tu cookie sin dejar de ser archivos.
 *
 * El desplegable es el `dropdown` de daisyUI en su variante **sin JavaScript**:
 * abre con el foco y cierra al perderlo. Eso importa aquí más que en ningún
 * sitio, porque este HTML llega tarde —después de la carga— y cualquier
 * manejador puesto al arrancar la página no lo habría visto nacer. Y porque
 * esta barra sale en las treinta y cuatro páginas estáticas: no puede arrastrar
 * un paquete de scripts a todas ellas para abrir un menú.
 *
 * Salir sigue siendo un `POST` a `/salir`, por lo mismo.
 */
import { isAdminUser } from '@/auth';
import { routes } from '@/routes';

const user = Astro.locals.user;

/** La administración solo se ofrece a quien puede entrar ahí. */
const esAdmin = isAdminUser(user);

/** La inicial del nombre, o del correo si no dio nombre. */
const initial = (user?.name || user?.email || '?').trim().charAt(0).toUpperCase();

/** El nombre corto: si no hay nombre, lo que va antes de la arroba. */
const label = user?.name?.trim() || user?.email.split('@')[0] || '';
---

{
  user ? (
    <div class="dropdown dropdown-end shrink-0">
      <div
        tabindex="0"
        role="button"
        aria-haspopup="menu"
        class="btn h-11 min-h-11 gap-2 rounded-full border-line bg-surface px-3 font-semibold text-ink-dim hover:border-line-strong hover:bg-raised hover:text-ink"
      >
        <span
          class="figures flex size-7 shrink-0 items-center justify-center rounded-full bg-raised text-xs font-black text-ink"
          aria-hidden="true"
        >
          {initial}
        </span>
        <span class="hidden max-w-32 truncate md:inline">{label}</span>
        <span class="sr-only">Tu cuenta: {user.email}</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </div>

      <ul
        tabindex="0"
        class="menu dropdown-content z-50 mt-2 w-56 rounded-card border border-line bg-raised p-2"
      >
        <li class="menu-title px-3 pt-1 pb-2 text-xs font-bold tracking-normal text-ink-faint normal-case">
          <span class="block truncate">{user.email}</span>
        </li>
        <li>
          <a href={routes.settings()} class="text-ink-dim hover:text-ink">
            Ajustes
          </a>
        </li>
        {esAdmin && (
          <li>
            <a href={routes.admin()} class="text-ink-dim hover:text-ink">
              Cuentas
            </a>
          </li>
        )}
        {/* El formulario es el elemento de la lista: daisyUI le da el hueco y el
            estado de foco, y el botón lo rellena entero. */}
        <li>
          <form method="POST" action={routes.signOut()} class="text-ink-dim hover:text-ink">
            <button type="submit" class="w-full cursor-pointer text-left">
              Salir
            </button>
          </form>
        </li>
      </ul>
    </div>
  ) : (
    <a
      href={routes.login()}
      class="btn h-11 min-h-11 shrink-0 rounded-full border-line bg-surface px-5 font-bold text-ink hover:border-line-strong hover:bg-raised"
    >
      Entrar
    </a>
  )
}
