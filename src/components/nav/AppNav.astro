---
import AccountPill from '@/components/nav/AccountPill.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { isActiveRoute, routes } from '@/routes';

const current = Astro.url.pathname;

const links: ReadonlyArray<{ href: string; label: string; icon: IconName }> = [
  { href: routes.home(), label: 'Mesociclo', icon: 'mesocycle' },
  { href: routes.exercises(), label: 'Ejercicios', icon: 'catalog' },
  { href: routes.history(), label: 'Historial', icon: 'history' },
  { href: routes.settings(), label: 'Ajustes', icon: 'settings' },
];
---

<header class="cabecera sticky top-0 z-40 backdrop-blur-xl">
  {
    /* Por debajo de `sm` no caben en una fila el logotipo, los cuatro enlaces y la
       cuenta: la navegación baja a su propia fila a todo el ancho, repartida a
       partes iguales. Con la cabecera `sticky`, la alternativa (dejar que la
       navegación se desplace dentro de un hueco de 60px) esconde tres de los
       cuatro destinos. */
  }
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:flex-nowrap sm:px-6 lg:px-8"
  >
    <a
      href={routes.home()}
      class="flex shrink-0 items-center gap-2.5 text-sm font-black tracking-[-0.01em] text-ink"
    >
      <img src="/mfwi.webp" alt="" class="w-40" />
    </a>

    <nav
      aria-label="Navegación principal"
      class="order-last flex basis-full gap-1 overflow-x-auto rounded-full border border-line bg-surface p-1 sm:order-none sm:ml-auto sm:basis-auto"
    >
      {
        links.map((link) => {
          const active = isActiveRoute(current, link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex min-h-11 flex-1 shrink-0 items-center justify-center gap-2 rounded-full px-4 text-sm font-semibold whitespace-nowrap transition-colors sm:flex-none',
                // El estado activo se lee por superficie y peso, no por color.
                active ? 'bg-raised font-bold text-ink' : 'text-ink-dim hover:text-ink',
              ]}
            >
              <Icon name={link.icon} size={18} class="shrink-0" />
              {/* Oculto a la vista en pantallas pequeñas, no al lector de pantalla:
                  con `hidden` el enlace se quedaba sin nombre y solo se oía «enlace». */}
              <span class="sr-only md:not-sr-only">{link.label}</span>
            </a>
          );
        })
      }
    </nav>

    {
      /**
       * La píldora de cuenta, de dos maneras según dónde esté.
       *
       * **En una página que ya corre en el servidor** se pinta ahí mismo:
       * `Astro.locals.user` ya está relleno, así que llega con el HTML y no hay
       * nada que esperar ni nada que salte. Es el caso de `/admin`,
       * `/historial`, `/configuracion` y las demás con sesión.
       *
       * **En una página estática** no queda otra que `server:defer`: son
       * archivos en disco y no saben quién los pide. Ahí sí hay una segunda
       * petición, y por eso hay hueco reservado.
       *
       * El hueco tiene **exactamente el tamaño final**, que es lo único que
       * evita el salto. Antes medía 52px de alto contra los 44 de la píldora, y
       * el ancho ni siquiera era fijo: al llegar, empujaba toda la barra.
       */
    }
    <div class="order-2 ml-auto h-11 w-[4.75rem] shrink-0 sm:order-none sm:ml-0 md:w-40">
      {
        Astro.isPrerendered ? (
          <AccountPill server:defer>
            <div slot="fallback" class="h-11 w-full skeleton rounded-full" aria-hidden="true" />
          </AccountPill>
        ) : (
          <AccountPill />
        )
      }
    </div>
  </div>
</header>
