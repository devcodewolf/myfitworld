---
import AccountPill from '@/components/nav/AccountPill.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { isActiveRoute, routes } from '@/routes';

const current = Astro.url.pathname;

const links: ReadonlyArray<{ href: string; label: string; icon: IconName }> = [
  { href: routes.home(), label: 'Mesociclo', icon: 'mesocycle' },
  { href: routes.exercises(), label: 'Ejercicios', icon: 'catalog' },
  { href: routes.history(), label: 'Historial', icon: 'history' },
  { href: routes.settings(), label: 'Ajustes', icon: 'settings' },
];
---

<header class="cabecera sticky top-0 z-40 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href={routes.home()}
      class="flex shrink-0 items-center gap-2.5 text-sm font-black tracking-[-0.01em] text-ink"
    >
      <img src="/mfwi.webp" alt="" class="w-40" />
    </a>

    <nav
      aria-label="Navegación principal"
      class="ml-auto flex gap-1 overflow-x-auto rounded-full border border-line bg-surface p-1"
    >
      {
        links.map((link) => {
          const active = isActiveRoute(current, link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex min-h-11 shrink-0 items-center gap-2 rounded-full px-4 text-sm font-semibold whitespace-nowrap transition-colors',
                // El estado activo se lee por superficie y peso, no por color.
                active ? 'bg-raised font-bold text-ink' : 'text-ink-dim hover:text-ink',
              ]}
            >
              <Icon name={link.icon} size={18} class="shrink-0" />
              <span class="hidden md:inline">{link.label}</span>
            </a>
          );
        })
      }
    </nav>

    {
      /* `server:defer` lo deja fuera del build: la página se genera entera y
        este trozo llega después, ya sabiendo si hay cookie. El sustituto ocupa
        exactamente lo mismo para que la barra no dé un salto al aparecer. */
    }
    <AccountPill server:defer>
      <div
        slot="fallback"
        class="h-[3.25rem] w-[5.5rem] shrink-0 rounded-full border border-line bg-surface md:w-32"
        aria-hidden="true"
      >
      </div>
    </AccountPill>
  </div>
</header>
