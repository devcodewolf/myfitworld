---
import type { ExerciseBlock } from '@/core/model';
import type { ExerciseCatalog } from '@/core/training';
import { estimateBlockSeconds } from '@/core/training';
import { EQUIPMENT_LABELS, MUSCLE_LABELS, formatDuration, formatRepRange } from '@/core/labels';
import { routes, type DayContext } from '@/routes';

interface Props {
  block: ExerciseBlock;
  catalog: ExerciseCatalog;
  position: number;
  /** Se propaga al enlace del ejercicio para poder volver a este día. */
  from: DayContext;
}

const { block, catalog, position, from } = Astro.props;
const exercise = catalog.get(block.exerciseId);

// La cifra grande siempre lleva su unidad al lado: sin ella, "4 × 10-20" no
// dice si son repeticiones o segundos.
const prescription = block.repRange
  ? { figure: `${block.sets} × ${formatRepRange(block.repRange)}`, unit: 'reps' }
  : { figure: `${block.sets} × ${block.workSeconds}`, unit: 'segundos' };

// Cuánto cuesta este ejercicio: trabajo, tempo, lados y descansos incluidos.
const blockSeconds = estimateBlockSeconds(block, catalog);

const tempo = block.tempo?.eccentricSeconds ?? 0;
const details: string[] = [];
if (tempo >= 2) details.push(`excéntrica ${tempo} s`);
if (block.tempo && block.tempo.bottomPauseSeconds > 0) {
  details.push(`pausa ${block.tempo.bottomPauseSeconds} s abajo`);
}
if (exercise?.unilateral) details.push('por lado');
if (block.intraSideRestSeconds) details.push(`${block.intraSideRestSeconds} s entre lados`);
---

<li
  class="grid grid-cols-[2.5rem_1fr] items-start gap-x-4 gap-y-3 border-b border-line py-6 last:border-b-0 sm:grid-cols-[2.5rem_1fr_auto] sm:gap-x-8"
>
  <p class="figures pt-1 text-lg font-extrabold text-ink-faint">
    {String(position).padStart(2, '0')}
  </p>

  <div class="min-w-0">
    <h3 class="text-xl font-bold text-ink">
      {
        exercise ? (
          <a
            href={routes.exercise(exercise.id, from)}
            class="decoration-line-strong underline-offset-4 hover:underline"
          >
            {exercise.name}
          </a>
        ) : (
          block.exerciseId
        )
      }
    </h3>
    <p class="mt-1 text-sm text-ink-dim">
      {exercise?.primaryMuscles.map((muscle) => MUSCLE_LABELS[muscle]).join(' · ')}
      {
        exercise && (
          <span class="text-ink-faint"> · {EQUIPMENT_LABELS[exercise.equipment[0]!]}</span>
        )
      }
    </p>
    {block.notes && <p class="mt-2 max-w-[55ch] text-sm text-ink-faint">{block.notes}</p>}
  </div>

  <div class="figures col-start-2 sm:col-start-3 sm:text-right">
    <p class="text-figure font-extrabold text-ink">
      {prescription.figure}
      <span class="ml-2 text-sm font-semibold tracking-[0.14em] text-ink-faint uppercase">
        {prescription.unit}
      </span>
    </p>
    <p class="mt-1 text-sm text-ink-dim">
      <span class="font-bold text-ink">{formatDuration(blockSeconds)}</span> en total ·{' '}
      {block.restSeconds} s de descanso
      {details.length > 0 && <span class="text-ink-faint"> · {details.join(' · ')}</span>}
    </p>
  </div>
</li>
