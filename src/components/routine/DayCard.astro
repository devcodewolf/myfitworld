---
import type { Day, WeekPhase } from '@/core/model';
import type { ExerciseCatalog } from '@/core/training';
import { daySetCount, estimateDaySeconds } from '@/core/training';
import { formatDuration } from '@/core/labels';
import { routes } from '@/routes';
import { PHASE_PALETTE, dayPhoto } from '@/theme';
import PhotoCard from '@/components/ui/PhotoCard.astro';

interface Props {
  day: Day;
  weekOrder: number;
  /** La fase de la semana a la que pertenece el día, que le presta su color. */
  phase: WeekPhase;
  catalog: ExerciseCatalog;
  eager?: boolean;
  ratio?: string;
}

const { day, weekOrder, phase, catalog, eager = false, ratio = '5/4' } = Astro.props;
const palette = PHASE_PALETTE[phase];

const chips = [
  `${daySetCount(day)} series`,
  `${day.blocks.length} ejercicios`,
  formatDuration(estimateDaySeconds(day, catalog)),
];
---

<PhotoCard
  photo={dayPhoto(weekOrder, day.order)}
  alt=""
  href={routes.day(weekOrder, day.order)}
  eager={eager}
  ratio={ratio}
>
  <h3 class="text-2xl font-extrabold tracking-[-0.02em] text-balance text-ink">
    {day.title}
  </h3>
  <p class="figures mt-1.5 flex items-center gap-2 text-sm font-bold text-ink-dim">
    <span class:list={['h-0.5 w-6 rounded-full', palette.mark]} aria-hidden="true"></span>
    Día {day.order}
  </p>
  <ul class="figures mt-4 flex flex-wrap gap-2">
    {
      chips.map((chip) => (
        <li class="rounded-full border border-line bg-[color-mix(in_oklab,var(--color-ground)_65%,transparent)] px-3 py-1 text-xs font-semibold text-ink backdrop-blur-sm">
          {chip}
        </li>
      ))
    }
  </ul>
</PhotoCard>
